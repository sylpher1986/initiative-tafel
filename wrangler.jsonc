// Cloudflare Workers: statische bestanden (de app) plus een kleine Worker voor /api/*.
// run_worker_first: alleen /api/* gaat langs worker/index.js, al het andere serveert Cloudflare direct uit de assets.
// ROOMS: Durable Object per spelersscherm-kamer (worker/room.js). SQLite-backend: werkt op het gratis plan.
{
  "name": "initiative-tafel",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ]
}
