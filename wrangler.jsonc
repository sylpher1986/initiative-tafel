// Cloudflare Workers: statische bestanden (de app) plus een kleine Worker voor /api/*.
// run_worker_first: alleen /api/* gaat langs worker/index.js, al het andere serveert Cloudflare direct uit de assets.
// ROOMS: Durable Object per spelersscherm-kamer (worker/room.js). SQLite-backend: werkt op het gratis plan.
{
  "name": "initiative-tafel",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ],
  // ROOM_LIMIT: max nieuwe kamers per IP per minuut (POST /api/room, zie roomAllowed in worker/room.js).
  // Houd limit gelijk aan ROOM_LIMIT_N en period op 60 (retry-after en melding rekenen daarmee; test bewaakt beide).
  // namespace_id: geheel getal als string, uniek binnen het Cloudflare-account. Vereist Wrangler >= 4.36 bij deploy.
  "ratelimits": [
    { "name": "ROOM_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ]
}
